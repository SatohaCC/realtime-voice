# Frontend（Next.js 開発時のプロキシ先）
BACKEND_URL=http://127.0.0.1:8000

# Frontend / Backend 共通（信頼するアプリの公開URL。任意の Host ヘッダーを信用しないため）
APP_PUBLIC_URL=http://localhost:3000

# Backend（Deepgram API キー / Supabase Auth 検証設定）
DEEPGRAM_KEY=
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRANSCRIPTION_MAX_SESSION_SECONDS=240
SOAP_LLM_PROVIDER=fake
SOAP_LLM_MODEL=
SOAP_LLM_TIMEOUT_SECONDS=15.0
