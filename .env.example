# Frontend（Next.js 開発時のプロキシ先）
BACKEND_URL=http://127.0.0.1:8000

# Frontend / Backend 共通（信頼するアプリの公開URL。任意の Host ヘッダーを信用しないため）
APP_PUBLIC_URL=http://localhost:3000

# Backend（Deepgram / Gemini / Supabase Auth 検証設定）
DEEPGRAM_KEY=
DEEPGRAM_MODEL=nova-3
# 精度優先: チャンネルを維持し、小声・語頭・語尾を音量で切り捨てない
STT_MONO_MIX_ENABLED=false
STT_VAD_ENABLED=false
STT_VAD_RMS_THRESHOLD=0.008
STT_VAD_PREROLL_MS=300
STT_VAD_HANGOVER_MS=600
STT_KEEPALIVE_INTERVAL_SECONDS=4.0
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRANSCRIPTION_MAX_SESSION_SECONDS=240
SOAP_LLM_PROVIDER=google_genai
SOAP_LLM_MODEL=gemini-4-hydrogen
SOAP_LLM_FINALIZE_MODEL=
SOAP_LLM_THINKING_BUDGET=0
SOAP_LLM_MAX_TOKENS=2048
SOAP_LLM_TIMEOUT_SECONDS=15.0
SOAP_MIN_INTERVAL_SECONDS=12.0
SOAP_MAX_BATCH_WAIT_SECONDS=12.0
GOOGLE_API_KEY=
