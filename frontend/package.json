    "@ui-sdk/core": "0.1.0-beta.2",
    "@ui-sdk/react": "0.1.0-beta.2",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@storybook/nextjs-vite": "^10.6.7",
    "@stylexjs/babel-plugin": "^0.19.2",
    "@stylexjs/postcss-plugin": "^0.19.2",
