{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/.next", "!**/node_modules", "!**/storybook-static"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" }
        },
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "shorthand" }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/features/**",
                      "**/app/**",
                      "@/shared/lib",
                      "@/shared/lib/**",
                      "**/../lib/**",
                      "@/shared/components",
                      "@/shared/components/**",
                      "**/../components/**",
                      "@supabase/**",
                      "@tanstack/react-query",
                      "@tanstack/react-query/**",
                      "next",
                      "next/**"
                    ],
                    "message": "shared/ui は共有スタイルと UI 部品に依存し、データや操作は Props で受け取ってください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/features/**",
                      "**/app/**",
                      "@/shared/lib",
                      "@/shared/lib/**",
                      "**/../lib/**",
                      "@ui-sdk/**",
                      "@supabase/**",
                      "@tanstack/react-query",
                      "@tanstack/react-query/**",
                      "next",
                      "next/**"
                    ],
                    "message": "shared/components は shared/ui と共有スタイルで構成し、データや操作は Props で受け取ってください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/**", "src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@ui-sdk/**", "@tanstack/react-query", "@tanstack/react-query/**"],
                    "message": "UI 部品は @/shared/ui、クエリ機能は @/shared/lib から import してください。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/shared/components/**", "src/features/**", "src/app/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "button": "生の <button> は使用せず、@/shared/ui の Button / Chip / FileTrigger を使用してください。",
                  "input": "生の <input> は使用せず、@/shared/ui の TextField / Checkbox / FileTrigger を使用してください。",
                  "select": "生の <select> は使用せず、@/shared/ui のコンポーネントを使用してください。",
                  "textarea": "生の <textarea> は使用せず、@/shared/ui のコンポーネントを使用してください。"
                }
              }
            }
          }
        }
      }
    }
  ]
}
